{
  "name": "mercearia-do-bairro-academia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "dev": "npm run sync && vite",
    "build": "npm run sync && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:mockups": "node scripts/test-mockups.mjs",
    "test:e2e": "node scripts/smoke-e2e.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"api/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"api/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" \"*.{js,ts}\"",
    "test:coverage": "vitest run --coverage",
    "test:lighthouse": "npx --yes @lhci/cli@0.16.1 autorun"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource/host-grotesk": "^5.3.0",
    "@vercel/blob": "^2.9.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "pyodide": "^0.26.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.5",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
